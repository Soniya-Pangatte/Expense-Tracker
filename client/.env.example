# =====================================================================
# SpendWise Frontend Client Configuration (.env.example)
# Duplicate this file as .env in client directory
# Note: VITE_ variables are bundled in client assets. Never put secrets here!
# =====================================================================

# Supabase Public API Credentials
# Found under: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
