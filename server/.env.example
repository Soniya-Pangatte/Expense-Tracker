# =====================================================================
# SpendWise Backend Server Configuration (.env.example)
# Duplicate this file as .env in production / local environment
# =====================================================================

# Server Environment & Port
NODE_ENV=production
PORT=5000

# CORS Allowed Origins (Comma-separated for multi-domain support)
# Example: https://spendwise.vercel.app,http://localhost:3000
CORS_ORIGIN=https://your-spendwise-frontend.vercel.app

# Supabase PostgreSQL & Auth Credentials
# Found under: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Google Gemini AI Integration (Required for AI Chatbot & OCR Vision)
# Obtain free API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Optional Bootstrap Administrator Emails (Comma-separated)
# Automatically grants initial admin rights to listed emails
ADMIN_EMAILS=admin@spendwise.io
